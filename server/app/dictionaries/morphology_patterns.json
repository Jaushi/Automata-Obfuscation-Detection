{
  "prefixes": {
    "mag": "^mag[a-z]+$",
    "nag": "^nag[a-z]+$",
    "pag": "^pag[a-z]+$",
    "grabe": "^gra+be+h*[a-z]*$",
    "sobrang": "^sobra+ng[a-z]+$"
  },

  "suffixes": {
    "ko": "[a-z]+ko$",
    "mo": "[a-z]+mo$",
    "niya": "[a-z]+niya$",
    "natin": "[a-z]+natin$",
    "ninyo": "[a-z]+ninyo$",
    "nila": "[a-z]+nila$",
    "na": "[a-z]+na$",
    "pa": "[a-z]+pa$",
    "man": "[a-z]+man$",
    "an": "[a-z]+an$",
    "in": "[a-z]+in$"
  },

  "lengthening": {
    "vowel_lengthening": "[aeiou]{2,}",
    "consonant_lengthening": "([bcdfghjklmnpqrstvwxyz])\\1{1,}"
  },

  "reduplication": {
    "full_reduplication": "^([a-z]+)\\1+$",
    "partial_reduplication": "^([bcdfghjklmnpqrstvwxyz][aeiou])\\1[a-z]*$"
  },

  "deletion_patterns": {
    "vowel_deleted": "^[^aeiou]+$",
    "compressed_vowels": "^[a-z]*[aeiou][^aeiou]+$"
  },

  "substitution_patterns": {
    "phonetic_variants": [
      "ph", "f",
      "c", "k",
      "ch", "ts",
      "th", "t"
    ]
  },

  "coverage_assumption": {
    "note": "Patterns apply to any alphabetic token for obfuscation detection"
  }
}
